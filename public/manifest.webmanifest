{
  "name": "Soulrift Crusher",
  "short_name": "Soulrift",
  "description": "Idle dungeon RPG. Hire heroes, crush floors, craft gear, fight in the arena, and war across servers.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser", "window-controls-overlay", "tabbed"],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["games", "entertainment"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "edge_side_panel": { "preferred_width": 420 },
  "protocol_handlers": [{ "protocol": "web+soulrift", "url": "/?join=%s" }],
  "background_color": "#0c0a0b",
  "theme_color": "#0c0a0b",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Fight", "short_name": "Fight", "url": "/?tab=fight", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Heroes", "short_name": "Heroes", "url": "/?tab=heroes", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Craft", "short_name": "Craft", "url": "/?tab=shop", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Clans", "short_name": "Clans", "url": "/?tab=clan", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "screenshots": [
    { "src": "/pwa/phone-title.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Title" },
    { "src": "/pwa/phone-fight.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Fight" },
    { "src": "/pwa/wide-fight.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Dungeon fight" },
    { "src": "/pwa/wide-heroes.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Heroes" }
  ]
}
